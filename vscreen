#!/usr/bin/env bash
# vscreen — virtual display streamed over VNC
# Direct connect. No middleman. No browser required.
# https://github.com/erinoooo/vscreen

set -euo pipefail

# ── Constants ─────────────────────────────────────────────────────────────────
VSCREEN_VERSION="0.1.1"
VSCREEN_CONF="/etc/vscreen/config"
VSCREEN_EDID="/etc/vscreen/edid.bin"
PASSWD_FILE="/etc/vscreen/passwd"
XORG_CONF="/etc/X11/xorg.conf.d/20-vscreen.conf"
DISPLAY_NUM=":1"

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${BLUE}→${RESET} $*"; }
success() { echo -e "${GREEN}✓${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
error()   { echo -e "${RED}✗${RESET} $*" >&2; }
header()  { echo -e "\n${BOLD}${CYAN}$*${RESET}"; }
die()     { error "$*"; exit 1; }

# ── Root check ────────────────────────────────────────────────────────────────
require_root() {
    [[ $EUID -eq 0 ]] || die "vscreen needs root. Run: sudo vscreen $*"
}

# ── Load config ───────────────────────────────────────────────────────────────
load_config() {
    [[ -f "$VSCREEN_CONF" ]] && source "$VSCREEN_CONF"
    RESOLUTION="${RESOLUTION:-1920x1080}"
    REFRESH="${REFRESH:-60}"
    VNC_PORT="${VNC_PORT:-5900}"
    GPU_MODE="${GPU_MODE:-none}"
}

# ── Get public IP ─────────────────────────────────────────────────────────────
get_public_ip() {
    local ip
    ip=$(curl -s --max-time 3 https://api.ipify.org 2>/dev/null)   ||
    ip=$(curl -s --max-time 3 https://ifconfig.me 2>/dev/null)     ||
    ip=$(curl -s --max-time 3 https://icanhazip.com 2>/dev/null)   ||
    ip=$(hostname -I | awk '{print $1}')
    echo "${ip// /}"
}

# ─────────────────────────────────────────────────────────────────────────────
# INSTALL
# ─────────────────────────────────────────────────────────────────────────────
cmd_install() {
    require_root install

    header "vscreen $VSCREEN_VERSION — installer"
    echo "Target: Ubuntu 22.04/24.04 — pure VNC, direct connect"
    echo ""

    if ! grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
        warn "Not Ubuntu — vscreen is tested on 22.04/24.04. Continuing anyway."
    fi

    # ── Packages ──────────────────────────────────────────────────────────────
    info "Installing packages..."
    apt-get update -qq
    apt-get install -y -qq \
        linux-headers-"$(uname -r)" \
        dkms \
        build-essential \
        git \
        curl \
        wget \
        x11vnc \
        xauth \
        xfce4 \
        xfce4-terminal \
        xfce4-notifyd \
        thunar \
        dbus-x11 \
        python3 \
        xserver-xorg-core \
        xserver-xorg-video-dummy \
        x11-xserver-utils \
        x11-utils \
        pciutils \
        2>/dev/null
    success "Packages installed"

    # ── evdi ──────────────────────────────────────────────────────────────────
    info "Installing evdi kernel module..."
    install_evdi
    success "evdi ready"

    # ── Directories ───────────────────────────────────────────────────────────
    install -d -m 755 /etc/vscreen

    # ── Default config ────────────────────────────────────────────────────────
    # Detect GPU first — needed whether or not config already exists
    local detected_gpu
    detected_gpu=$(detect_gpu)

    if [[ ! -f "$VSCREEN_CONF" ]]; then
        cat > "$VSCREEN_CONF" <<CONFEOF
# vscreen configuration
RESOLUTION="1920x1080"
REFRESH="60"
VNC_PORT="5900"
GPU_MODE="${detected_gpu}"
CONFEOF
        success "Config written to $VSCREEN_CONF"
    else
        # Config exists — preserve user settings but always refresh GPU_MODE
        # in case drivers were installed since last run
        if grep -q "^GPU_MODE=" "$VSCREEN_CONF"; then
            sed -i "s/^GPU_MODE=.*/GPU_MODE=\"${detected_gpu}\"/" "$VSCREEN_CONF"
        else
            echo "GPU_MODE=\"${detected_gpu}\"" >> "$VSCREEN_CONF"
        fi
        info "Config exists at $VSCREEN_CONF — preserved (GPU_MODE updated to: ${detected_gpu})"
    fi

    # ── EDID ──────────────────────────────────────────────────────────────────
    info "Writing EDID (spoofed Dell P2419H)..."
    write_edid
    success "EDID written"

    # ── Xorg config ───────────────────────────────────────────────────────────
    info "Detecting GPU..."
    write_xorg_conf
    success "Xorg config written"

    # ── systemd services ──────────────────────────────────────────────────────
    info "Installing systemd services..."
    write_systemd_services
    systemctl daemon-reload
    success "Services installed"

    # ── VNC password ──────────────────────────────────────────────────────────
    if [[ ! -f "$PASSWD_FILE" ]]; then
        echo ""
        set_vnc_password
    else
        info "VNC password already set. Change it with: sudo vscreen password"
    fi

    # ── Install binary ────────────────────────────────────────────────────────
    if [[ "$(realpath "$0")" != "/usr/local/bin/vscreen" ]]; then
        cp "$0" /usr/local/bin/vscreen
        chmod +x /usr/local/bin/vscreen
        success "vscreen installed to /usr/local/bin/vscreen"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}Installation complete.${RESET}"
    echo ""
    echo "  Start:   sudo vscreen start"
    echo "  Status:  sudo vscreen status"
    echo ""
}

# ── evdi ──────────────────────────────────────────────────────────────────────
install_evdi() {
    if lsmod | grep -q "^evdi"; then
        info "evdi already loaded"
        return
    fi

    if apt-get install -y -qq evdi-dkms 2>/dev/null; then
        modprobe evdi || true
        return
    fi

    info "Building evdi from source..."
    local build_dir
    build_dir=$(mktemp -d)
    git clone --depth 1 https://github.com/DisplayLink/evdi.git "$build_dir/evdi" -q
    cd "$build_dir/evdi"
    local evdi_ver
    evdi_ver=$(grep "^PACKAGE_VERSION" dkms.conf | cut -d= -f2 | tr -d '"')
    install -d /usr/src/evdi-"$evdi_ver"
    cp -r . /usr/src/evdi-"$evdi_ver"/
    dkms add     -m evdi -v "$evdi_ver" --force 2>/dev/null || true
    dkms build   -m evdi -v "$evdi_ver" 2>/dev/null
    dkms install -m evdi -v "$evdi_ver" --force 2>/dev/null
    modprobe evdi
    cd /
    rm -rf "$build_dir"
}

# ── EDID blob (1920x1080@60, spoofed as Dell P2419H) ─────────────────────────
write_edid() {
    python3 - <<'PYEOF'
import os

edid = bytearray(128)
edid[0:8]   = b'\x00\xff\xff\xff\xff\xff\xff\x00'
edid[8]     = 0x10; edid[9]  = 0xac
edid[10]    = 0xd0; edid[11] = 0x77
edid[12:16] = b'\x4c\x59\x41\x41'
edid[16]    = 30;   edid[17] = 34
edid[18]    = 1;    edid[19] = 4
edid[20]    = 0xa5
edid[21]    = 53;   edid[22] = 30
edid[23]    = 120
edid[24]    = 0x0a
edid[25:35] = b'\xce\x00\xa5\xa5\x55\x4a\x9b\x26\x10\x50'
edid[35]    = 0x21; edid[36] = 0x08
edid[38]    = int(1920/8) - 31
edid[39]    = 0x81
for i in range(40, 54, 2):
    edid[i] = 0x01; edid[i+1] = 0x01
timing = bytearray(18)
timing[0]  = 0x02; timing[1]  = 0x3a
timing[2]  = 0x80; timing[3]  = 0x18
timing[4]  = 0x71; timing[5]  = 0x38
timing[6]  = 0x2d; timing[7]  = 0x40
timing[8]  = 0x58; timing[9]  = 0x2c
timing[10] = 0x45; timing[17] = 0x1e
edid[54:72]  = timing
edid[72:90]  = bytes([0x00,0x00,0x00,0xFC,0x00,0x44,0x65,0x6c,0x6c,0x20,
                      0x50,0x32,0x34,0x31,0x39,0x48,0x0a,0x20])
edid[90:108] = bytes([0x00,0x00,0x00,0xFF,0x00,0x59,0x4b,0x52,0x59,0x41,
                      0x41,0x31,0x0a,0x20,0x20,0x20,0x20,0x20])
edid[108:126]= bytes([0x00,0x00,0x00,0x10,0x00]+[0x00]*13)
total = sum(edid[:127]) % 256
edid[127] = (256 - total) % 256
os.makedirs('/etc/vscreen', exist_ok=True)
with open('/etc/vscreen/edid.bin', 'wb') as f:
    f.write(edid)
PYEOF
}

# ── Modeline calculator ───────────────────────────────────────────────────────
xorg_modeline() {
    local W=$1 H=$2 HZ=${3:-60}
    cvt "$W" "$H" "$HZ" 2>/dev/null \
        | grep Modeline \
        | sed 's/Modeline "[^"]*" //' \
        || echo "148.50 1920 2008 2052 2200 1080 1084 1089 1125 +hsync +vsync"
}

# ── GPU detection ─────────────────────────────────────────────────────────────
# Returns "nvidia", or "none".
# Fails loudly if an NVIDIA GPU is present but drivers are not working —
# we never silently fall back, so the user knows exactly what's wrong.
detect_gpu() {
    # NOTE: all user-facing output goes to stderr (>&2) so this function
    # can be used in $() captures without polluting the return value.
    # Only the mode string ("nvidia" or "none") goes to stdout.

    if lspci 2>/dev/null | grep -qi "nvidia"; then
        if ! command -v nvidia-smi &>/dev/null; then
            die "NVIDIA GPU detected but nvidia-smi not found.
       Install NVIDIA drivers first:

         sudo ubuntu-drivers autoinstall
         sudo reboot

       Then re-run: sudo vscreen install"
        fi

        if ! nvidia-smi &>/dev/null; then
            die "NVIDIA GPU detected but nvidia-smi failed.
       Your NVIDIA drivers may be broken or not loaded.

       Try:  sudo modprobe nvidia
       Or:   sudo ubuntu-drivers autoinstall && sudo reboot

       Then re-run: sudo vscreen install"
        fi

        local gpu_name
        gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
        success "NVIDIA GPU detected: ${gpu_name}" >&2
        echo "nvidia"
        return
    fi

    info "No NVIDIA GPU detected — using software dummy driver" >&2
    echo "none"
}

# ── Xorg config — NVIDIA (headless, full GPU rendering) ──────────────────────
# Key options that make NVIDIA work headless:
#   AllowEmptyInitialConfiguration — don't require a physically connected display
#   UseDisplayDevice none          — don't scan for physical outputs
#   ConnectedMonitor DFP-0         — pretend DFP-0 (first DP output) exists
#   CustomEDID                     — inject our fake Dell monitor EDID so the
#                                    driver reports a real connected monitor
write_xorg_conf_nvidia() {
    load_config
    mkdir -p /etc/X11/xorg.conf.d

    cat > "$XORG_CONF" <<EOF
# vscreen — NVIDIA GPU (headless mode)
# Generated by vscreen $VSCREEN_VERSION

Section "ServerLayout"
    Identifier  "vscreen-layout"
    Screen 0    "vscreen-screen"
EndSection

Section "Device"
    Identifier  "vscreen-device"
    Driver      "nvidia"
    Option      "AllowEmptyInitialConfiguration" "true"
    Option      "UseDisplayDevice"               "none"
    Option      "ConnectedMonitor"               "DFP-0"
    Option      "CustomEDID"                     "DFP-0:${VSCREEN_EDID}"
    Option      "ModeValidation"                 "NoMaxPClkCheck, NoEdidMaxPClkCheck, NoVesaModes"
    Option      "HardDPMS"                       "false"
EndSection

Section "Monitor"
    Identifier  "vscreen-monitor"
    HorizSync   28-160
    VertRefresh 48-75
    Option      "DPMS"  "false"
EndSection

Section "Screen"
    Identifier  "vscreen-screen"
    Device      "vscreen-device"
    Monitor     "vscreen-monitor"
    DefaultDepth 24
    SubSection "Display"
        Depth   24
        Modes   "${RESOLUTION}"
    EndSubSection
EndSection
EOF
}

# ── Xorg config — dummy (software, no GPU) ────────────────────────────────────
write_xorg_conf_dummy() {
    load_config
    mkdir -p /etc/X11/xorg.conf.d

    local W H
    W=$(echo "${RESOLUTION}" | cut -dx -f1)
    H=$(echo "${RESOLUTION}" | cut -dx -f2)

    cat > "$XORG_CONF" <<EOF
# vscreen — software dummy driver (no GPU)
# Generated by vscreen $VSCREEN_VERSION

Section "Device"
    Identifier  "vscreen-device"
    Driver      "dummy"
    VideoRam    256000
EndSection

Section "Monitor"
    Identifier  "vscreen-monitor"
    HorizSync   28-160
    VertRefresh 48-75
    Option      "DPMS"  "false"
    Modeline    "${RESOLUTION}" $(xorg_modeline ${W} ${H} ${REFRESH})
EndSection

Section "Screen"
    Identifier  "vscreen-screen"
    Device      "vscreen-device"
    Monitor     "vscreen-monitor"
    DefaultDepth 24
    SubSection "Display"
        Depth   24
        Modes   "${RESOLUTION}"
        Virtual ${W} ${H}
    EndSubSection
EndSection
EOF
}

# ── Xorg config — dispatcher ──────────────────────────────────────────────────
write_xorg_conf() {
    local gpu
    gpu=$(detect_gpu)
    case "$gpu" in
        nvidia) write_xorg_conf_nvidia ;;
        *)      write_xorg_conf_dummy  ;;
    esac
}

# ── systemd services ──────────────────────────────────────────────────────────
write_systemd_services() {
    load_config

    # X11 server
    cat > /etc/systemd/system/vscreen-display.service <<EOF
[Unit]
Description=vscreen virtual display (X11)
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/bin/bash -c 'modprobe evdi || true'
ExecStart=/usr/bin/Xorg ${DISPLAY_NUM} -config ${XORG_CONF} -nolisten tcp vt7
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    # XFCE4 desktop
    cat > /etc/systemd/system/vscreen-desktop.service <<EOF
[Unit]
Description=vscreen desktop (XFCE4)
After=vscreen-display.service
Requires=vscreen-display.service

[Service]
Type=simple
User=root
Environment=DISPLAY=${DISPLAY_NUM}
Environment=HOME=/root
Environment=XDG_RUNTIME_DIR=/run/user/0
ExecStartPre=/bin/bash -c 'mkdir -p /run/user/0 && chmod 700 /run/user/0'
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/dbus-launch --exit-with-session /usr/bin/xfce4-session
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    # x11vnc
    cat > /etc/systemd/system/vscreen-vnc.service <<EOF
[Unit]
Description=vscreen VNC server (x11vnc)
After=vscreen-desktop.service
Requires=vscreen-display.service

[Service]
Type=simple
User=root
Environment=DISPLAY=${DISPLAY_NUM}
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/x11vnc \\
    -display  ${DISPLAY_NUM} \\
    -rfbport  ${VNC_PORT} \\
    -rfbauth  ${PASSWD_FILE} \\
    -shared \\
    -forever \\
    -repeat \\
    -noxrecord \\
    -nowireframe \\
    -nodpms \\
    -threads \\
    -logfile /var/log/vscreen-vnc.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
}

# ── VNC password ──────────────────────────────────────────────────────────────
set_vnc_password() {
    echo -e "${BOLD}Set VNC password${RESET}"
    echo "  This is what you'll enter in your VNC client to connect."
    echo "  (VNC passwords are max 8 characters)"
    echo ""

    local pass pass2
    while true; do
        read -rsp "  Password: " pass; echo ""
        [[ -n "$pass" ]] || { warn "Password cannot be empty."; continue; }
        read -rsp "  Confirm:  " pass2; echo ""
        [[ "$pass" == "$pass2" ]] && break
        warn "Passwords don't match. Try again."
    done

    x11vnc -storepasswd "$pass" "$PASSWD_FILE" 2>/dev/null
    chmod 600 "$PASSWD_FILE"
    success "VNC password set."
}

# ─────────────────────────────────────────────────────────────────────────────
# START
# ─────────────────────────────────────────────────────────────────────────────
cmd_start() {
    require_root start
    load_config

    [[ -f "$VSCREEN_CONF" ]] || die "vscreen not installed. Run: sudo vscreen install"
    [[ -f "$PASSWD_FILE"  ]] || die "No VNC password set. Run: sudo vscreen password"

    header "vscreen — starting"

    modprobe evdi 2>/dev/null || true

    info "Starting virtual display..."
    systemctl start vscreen-display
    sleep 2

    info "Starting XFCE4 desktop..."
    systemctl start vscreen-desktop
    sleep 3

    info "Starting VNC server..."
    systemctl start vscreen-vnc
    sleep 1

    local ip
    ip=$(get_public_ip)

    echo ""
    echo -e "${GREEN}${BOLD}vscreen is running.${RESET}"
    echo ""
    echo -e "  ${BOLD}Connect:${RESET}  ${CYAN}${ip}:${VNC_PORT}${RESET}"
    echo ""
    echo -e "  Resolution:  ${RESOLUTION} @ ${REFRESH}Hz"
    echo -e "  Display:     ${DISPLAY_NUM}"
    echo ""
    echo "  Open any VNC client and connect to the address above."
    echo "  Use your VNC password when prompted."
    echo ""
    warn "Make sure port ${VNC_PORT} (TCP) is open inbound on your server's firewall."
    echo ""
    echo "  Stop:            sudo vscreen stop"
    echo "  Status:          sudo vscreen status"
    echo "  Change password: sudo vscreen password"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# STOP
# ─────────────────────────────────────────────────────────────────────────────
cmd_stop() {
    require_root stop

    header "vscreen — stopping"
    systemctl stop vscreen-vnc     2>/dev/null || true
    systemctl stop vscreen-desktop 2>/dev/null || true
    systemctl stop vscreen-display 2>/dev/null || true
    success "Stopped."
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# RESTART
# ─────────────────────────────────────────────────────────────────────────────
cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

# ─────────────────────────────────────────────────────────────────────────────
# STATUS
# ─────────────────────────────────────────────────────────────────────────────
cmd_status() {
    require_root status
    load_config

    header "vscreen — status"
    echo ""

    local services=(vscreen-display vscreen-desktop vscreen-vnc)
    for svc in "${services[@]}"; do
        local state
        state=$(systemctl is-active "$svc" 2>/dev/null)
        if [[ "$state" == "active" ]]; then
            echo -e "  ${GREEN}●${RESET} $svc"
        else
            echo -e "  ${RED}○${RESET} $svc  (${state})"
        fi
    done

    echo ""
    local ip
    ip=$(get_public_ip)
    echo -e "  ${BOLD}Connect:${RESET}  ${CYAN}${ip}:${VNC_PORT}${RESET}"
    echo ""
    echo -e "  Resolution:  ${RESOLUTION} @ ${REFRESH}Hz"
    echo -e "  Display:     ${DISPLAY_NUM}"
    echo -e "  VNC port:    ${VNC_PORT}"

    # GPU mode
    local gpu_mode="${GPU_MODE:-unknown}"
    if [[ "$gpu_mode" == "nvidia" ]]; then
        local gpu_name
        gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo "NVIDIA")
        echo -e "  GPU:         ${GREEN}${gpu_name}${RESET} (full acceleration)"
    else
        echo -e "  GPU:         software (dummy driver — no GPU detected at install time)"
    fi

    echo ""
    warn "Port ${VNC_PORT} must be open inbound on your server's firewall."
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# GPU
# ─────────────────────────────────────────────────────────────────────────────
cmd_gpu() {
    load_config
    header "vscreen — GPU info"
    echo ""

    # Check for NVIDIA hardware
    if ! lspci 2>/dev/null | grep -qi "nvidia"; then
        echo -e "  No NVIDIA GPU detected on this machine."
        echo -e "  vscreen is running with the software dummy driver."
        echo -e "  CPU-only rendering — no hardware acceleration."
        echo ""
        return
    fi

    echo -e "  ${GREEN}✓${RESET}  NVIDIA GPU present"

    # Driver
    if ! command -v nvidia-smi &>/dev/null; then
        echo -e "  ${RED}✗${RESET}  nvidia-smi not found — drivers not installed"
        echo ""
        echo "  Install drivers:  sudo ubuntu-drivers autoinstall && sudo reboot"
        echo "  Then reinstall:   sudo vscreen install"
        echo ""
        return
    fi

    if ! nvidia-smi &>/dev/null; then
        echo -e "  ${RED}✗${RESET}  nvidia-smi failed — driver may be broken or not loaded"
        echo ""
        echo "  Try:  sudo modprobe nvidia"
        echo "  Or:   sudo ubuntu-drivers autoinstall && sudo reboot"
        echo ""
        return
    fi

    echo -e "  ${GREEN}✓${RESET}  nvidia-smi working"
    echo ""

    # GPU details
    nvidia-smi --query-gpu=name,driver_version,memory.total,utilization.gpu,temperature.gpu                --format=csv,noheader 2>/dev/null     | while IFS=',' read -r name driver mem util temp; do
        echo -e "  Name:        ${name# }"
        echo -e "  Driver:      ${driver# }"
        echo -e "  VRAM:        ${mem# }"
        echo -e "  GPU usage:   ${util# }"
        echo -e "  Temp:        ${temp# }°C"
    done

    echo ""

    # Is vscreen actually using the GPU?
    local gpu_mode="${GPU_MODE:-unknown}"
    if [[ "$gpu_mode" == "nvidia" ]]; then
        echo -e "  ${GREEN}✓${RESET}  vscreen is using the GPU (NVIDIA driver mode)"
    else
        echo -e "  ${YELLOW}⚠${RESET}  vscreen was installed without GPU mode"
        echo "  Re-run install to switch:  sudo vscreen install"
    fi

    echo ""

    # OpenGL check via glxinfo if available
    if command -v glxinfo &>/dev/null && systemctl is-active --quiet vscreen-display 2>/dev/null; then
        local renderer
        renderer=$(DISPLAY="$DISPLAY_NUM" glxinfo 2>/dev/null | grep "OpenGL renderer" | cut -d: -f2 | xargs)
        if [[ -n "$renderer" ]]; then
            echo -e "  OpenGL:      ${renderer}"
            if echo "$renderer" | grep -qi "nvidia"; then
                echo -e "  ${GREEN}✓${RESET}  Hardware OpenGL confirmed"
            else
                echo -e "  ${YELLOW}⚠${RESET}  OpenGL renderer is not NVIDIA — check your xorg.conf"
            fi
        fi
    else
        echo "  (Start vscreen to check OpenGL renderer: sudo vscreen start)"
    fi

    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# PASSWORD
# ─────────────────────────────────────────────────────────────────────────────
cmd_password() {
    require_root password

    header "vscreen — change VNC password"
    echo ""
    set_vnc_password

    if systemctl is-active --quiet vscreen-vnc 2>/dev/null; then
        info "Restarting VNC server to apply new password..."
        systemctl restart vscreen-vnc
        success "Done — new password active."
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# RESOLUTION
# ─────────────────────────────────────────────────────────────────────────────
cmd_resolution() {
    require_root resolution
    local res="${1:-}"
    [[ -n "$res" ]] || die "Usage: vscreen resolution <WIDTHxHEIGHT>  e.g. 2560x1440"
    [[ "$res" =~ ^[0-9]+x[0-9]+$ ]] || die "Invalid format. Use WIDTHxHEIGHT e.g. 1920x1080"

    load_config
    sed -i "s/^RESOLUTION=.*/RESOLUTION=\"${res}\"/" "$VSCREEN_CONF"

    if systemctl is-active --quiet vscreen-display; then
        info "Applying live via xrandr..."
        DISPLAY="$DISPLAY_NUM" xrandr --output HDMI-1    --mode "$res" 2>/dev/null ||
        DISPLAY="$DISPLAY_NUM" xrandr --output Virtual-1 --mode "$res" 2>/dev/null ||
        warn "Could not apply live — run: sudo vscreen restart"
    fi

    success "Resolution set to $res"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# PORT
# ─────────────────────────────────────────────────────────────────────────────
cmd_port() {
    require_root port
    local port="${1:-}"
    [[ -n "$port" ]] || die "Usage: vscreen port <number>  e.g. 5901"
    [[ "$port" =~ ^[0-9]+$ ]] || die "Port must be a number."

    load_config
    sed -i "s/^VNC_PORT=.*/VNC_PORT=\"${port}\"/" "$VSCREEN_CONF"
    write_systemd_services
    systemctl daemon-reload

    if systemctl is-active --quiet vscreen-vnc; then
        info "Restarting VNC server on new port..."
        systemctl restart vscreen-vnc
    fi

    success "VNC port set to $port"
    warn "Make sure port ${port} is open inbound on your server's firewall."
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# UNINSTALL
# ─────────────────────────────────────────────────────────────────────────────
cmd_uninstall() {
    require_root uninstall

    header "vscreen — uninstall"
    warn "This will remove all vscreen components."
    read -rp "  Are you sure? [y/N] " confirm
    [[ "$confirm" =~ ^[yY]$ ]] || { echo "Aborted."; exit 0; }

    for svc in vscreen-vnc vscreen-desktop vscreen-display; do
        systemctl stop    "$svc" 2>/dev/null || true
        systemctl disable "$svc" 2>/dev/null || true
        rm -f "/etc/systemd/system/${svc}.service"
    done
    systemctl daemon-reload

    rm -f  "$XORG_CONF"
    rm -rf /etc/vscreen

    success "vscreen uninstalled."
    rm -f /usr/local/bin/vscreen
}

# ─────────────────────────────────────────────────────────────────────────────
# HELP
# ─────────────────────────────────────────────────────────────────────────────
cmd_help() {
    cat <<EOF

${BOLD}vscreen${RESET} ${VSCREEN_VERSION} — virtual display over VNC

Tricks your headless Linux server into thinking a physical monitor is
connected, then exposes that display over VNC. Connect with any VNC
client. Direct connect. No browser. No middleman.

${BOLD}USAGE${RESET}
  sudo vscreen <command> [args]

${BOLD}COMMANDS${RESET}
  install               Install vscreen and all dependencies
  start                 Start virtual display + VNC server
  stop                  Stop everything
  restart               Stop then start
  status                Show running services and connection info
  password              Set or change the VNC password
  gpu                   Show GPU info and acceleration status
  resolution <WxH>      Change display resolution  (e.g. 2560x1440)
  port <number>         Change the VNC port        (default: 5900)
  uninstall             Remove vscreen completely
  help                  Show this help

${BOLD}QUICK START${RESET}
  curl -fsSL https://raw.githubusercontent.com/erinoooo/vscreen/main/install.sh | sudo bash
  sudo vscreen start
  # Connect with any VNC client to YOUR.IP:5900

${BOLD}RECOMMENDED VNC CLIENTS${RESET}
  macOS      RealVNC Viewer, Screens 5, built-in Screen Sharing (Finder → Go → Connect to Server → vnc://IP)
  Windows    RealVNC Viewer, TigerVNC Viewer
  Linux      Remmina, TigerVNC, KRDC
  iOS        RealVNC Viewer, Screens for iOS
  Android    RealVNC Viewer

${BOLD}NOTES${RESET}
  • Port 5900 (or your configured port) must be open inbound.
  • VNC passwords are capped at 8 characters (x11vnc / RFB protocol limit).
  • For extra security, tunnel over SSH instead of opening the port:
      ssh -L 5900:localhost:5900 user@your-server
    Then connect your VNC client to localhost:5900

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# DISPATCH
# ─────────────────────────────────────────────────────────────────────────────
main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        install)    cmd_install    "$@" ;;
        start)      cmd_start      "$@" ;;
        stop)       cmd_stop       "$@" ;;
        restart)    cmd_restart    "$@" ;;
        status)     cmd_status     "$@" ;;
        password)   cmd_password   "$@" ;;
        gpu)        cmd_gpu        "$@" ;;
        resolution) cmd_resolution "$@" ;;
        port)       cmd_port       "$@" ;;
        uninstall)  cmd_uninstall  "$@" ;;
        help|--help|-h)       cmd_help ;;
        version|--version|-v) echo "vscreen $VSCREEN_VERSION" ;;
        *) error "Unknown command: $cmd"; cmd_help; exit 1 ;;
    esac
}

main "$@"
