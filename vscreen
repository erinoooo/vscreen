# ── Modeline calculator ───────────────────────────────────────────────────────
xorg_modeline() {
    local W=$1 H=$2 HZ=${3:-60}
    local modeline
    modeline=$(cvt "$W" "$H" "$HZ" 2>/dev/null \
        | grep -i "^[[:space:]]*Modeline" \
        | sed 's/^[[:space:]]*Modeline "[^"]*"[[:space:]]*//')
    if [[ -z "$modeline" ]]; then
        echo "148.50 1920 2008 2052 2200 1080 1084 1089 1125 +hsync +vsync"
    else
        echo "$modeline"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# XORG CONFIGS
# ─────────────────────────────────────────────────────────────────────────────
write_xorg_conf_nvidia() {
    load_config
    mkdir -p /etc/X11/xorg.conf.d
    cat > "$XORG_CONF" <<EOF
Section "ServerLayout"
    Identifier  "vscreen-layout"
    Screen 0    "vscreen-screen"
EndSection

Section "Device"
    Identifier  "vscreen-device"
    Driver      "nvidia"
    Option      "AllowEmptyInitialConfiguration" "true"
    Option      "UseDisplayDevice"               "none"
    Option      "ConnectedMonitor"               "DFP-0"
    Option      "CustomEDID"                     "DFP-0:${VSCREEN_EDID}"
    Option      "ModeValidation"                 "NoMaxPClkCheck, NoEdidMaxPClkCheck, NoVesaModes"
    Option      "HardDPMS"                       "false"
EndSection

Section "Monitor"
    Identifier  "vscreen-monitor"
    HorizSync   28-160
    VertRefresh 48-75
    Option      "DPMS"  "false"
EndSection

Section "Screen"
    Identifier  "vscreen-screen"
    Device      "vscreen-device"
    Monitor     "vscreen-monitor"
    DefaultDepth 24
    SubSection "Display"
        Depth   24
        Modes   "${RESOLUTION}"
    EndSubSection
EndSection
EOF
}

write_xorg_conf_dummy() {
    load_config
    mkdir -p /etc/X11/xorg.conf.d
    local W H
    W=$(echo "${RESOLUTION}" | cut -dx -f1)
    H=$(echo "${RESOLUTION}" | cut -dx -f2)
    cat > "$XORG_CONF" <<EOF
Section "Device"
    Identifier  "vscreen-device"
    Driver      "dummy"
    VideoRam    256000
EndSection

Section "Monitor"
    Identifier  "vscreen-monitor"
    HorizSync   28-160
    VertRefresh 48-75
    Option      "DPMS"  "false"
    Modeline    "${RESOLUTION}" $(xorg_modeline "$W" "$H" "$REFRESH")
EndSection

Section "Screen"
    Identifier  "vscreen-screen"
    Device      "vscreen-device"
    Monitor     "vscreen-monitor"
    DefaultDepth 24
    SubSection "Display"
        Depth   24
        Modes   "${RESOLUTION}"
        Virtual ${W} ${H}
    EndSubSection
EndSection
EOF
}

write_xorg_conf() {
    load_config
    case "${GPU_MODE}" in
        nvidia) write_xorg_conf_nvidia ;;
        *)      write_xorg_conf_dummy  ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# HELPER SCRIPTS — used by both systemd and direct mode
# ─────────────────────────────────────────────────────────────────────────────
write_helper_scripts() {
    # Wait-for-display
    cat > /usr/local/bin/vscreen-wait-display <<'WAITEOF'
#!/usr/bin/env bash
DISPLAY="${1:-:1}"
TIMEOUT="${2:-30}"
elapsed=0
while ! DISPLAY="$DISPLAY" xdpyinfo &>/dev/null 2>&1; do
    sleep 0.5
    elapsed=$((elapsed + 1))
    if [[ $elapsed -ge $((TIMEOUT * 2)) ]]; then
        echo "vscreen: timed out waiting for display $DISPLAY after ${TIMEOUT}s" >&2
        exit 1
    fi
done
WAITEOF
    chmod +x /usr/local/bin/vscreen-wait-display

    # Xauth setup — grants vscreen user access to the X display
    cat > /usr/local/bin/vscreen-xauth-setup <<'XAUTHEOF'
#!/usr/bin/env bash
DISPLAY="${1:-:1}"
XAUTH_FILE="/home/vscreen/.Xauthority"
if command -v mcookie &>/dev/null; then
    COOKIE=$(mcookie)
    xauth -f "$XAUTH_FILE" add "$DISPLAY" . "$COOKIE" 2>/dev/null || true
    xauth add "$DISPLAY" . "$COOKIE" 2>/dev/null || true
    chown vscreen:vscreen "$XAUTH_FILE" 2>/dev/null || true
else
    DISPLAY="$DISPLAY" xhost +local: 2>/dev/null || true
fi
XAUTHEOF
    chmod +x /usr/local/bin/vscreen-xauth-setup
}

# ─────────────────────────────────────────────────────────────────────────────
# SYSTEMD SERVICES
# ─────────────────────────────────────────────────────────────────────────────
write_systemd_services() {
    load_config

    local uid
    uid=$(id -u "$VSCREEN_USER" 2>/dev/null || echo 1100)

    # ── Xorg ──────────────────────────────────────────────────────────────────
    cat > /etc/systemd/system/vscreen-display.service <<EOF
[Unit]
Description=vscreen virtual display (Xorg)
After=network.target
ConditionPathExists=${VSCREEN_CONF}
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/Xorg ${DISPLAY_NUM} -config ${XORG_CONF} -nolisten tcp -noreset vt7
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

    # ── XFCE4 desktop ─────────────────────────────────────────────────────────
    # The "+" prefix on ExecStartPre runs that line as root even though
    # User= is set to the vscreen user. This is how we create /run/user/UID
    # and set up xauth without permission errors.
    cat > /etc/systemd/system/vscreen-desktop.service <<EOF
[Unit]
Description=vscreen desktop (XFCE4)
After=vscreen-display.service
Requires=vscreen-display.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=${VSCREEN_USER}
Environment=DISPLAY=${DISPLAY_NUM}
Environment=HOME=${VSCREEN_HOME}
Environment=XDG_RUNTIME_DIR=/run/user/${uid}
Environment=XAUTHORITY=${VSCREEN_HOME}/.Xauthority
ExecStartPre=/usr/local/bin/vscreen-wait-display ${DISPLAY_NUM} 30
ExecStartPre=+/bin/bash -c 'mkdir -p /run/user/${uid} && chmod 700 /run/user/${uid} && chown ${VSCREEN_USER}:${VSCREEN_USER} /run/user/${uid}'
ExecStartPre=+/usr/local/bin/vscreen-xauth-setup ${DISPLAY_NUM}
ExecStart=/usr/bin/dbus-launch --exit-with-session /usr/bin/xfce4-session
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    # ── x11vnc ────────────────────────────────────────────────────────────────
    cat > /etc/systemd/system/vscreen-vnc.service <<EOF
[Unit]
Description=vscreen VNC server (x11vnc)
After=vscreen-desktop.service
Requires=vscreen-display.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=DISPLAY=${DISPLAY_NUM}
ExecStartPre=/usr/local/bin/vscreen-wait-display ${DISPLAY_NUM} 30
ExecStart=/usr/bin/x11vnc \\
    -display  ${DISPLAY_NUM} \\
    -rfbport  ${VNC_PORT} \\
    -rfbauth  ${PASSWD_FILE} \\
    -shared \\
    -forever \\
    -repeat \\
    -noxrecord \\
    -nowireframe \\
    -nodpms \\
    -threads \\
    -logfile ${LOG_DIR}/vnc.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# DIRECT MODE — start/stop processes with PID files (no systemd)
# ─────────────────────────────────────────────────────────────────────────────
direct_start() {
    load_config
    mkdir -p "$PID_DIR" "$LOG_DIR"

    # ── Xorg ──────────────────────────────────────────────────────────────────
    info "Starting Xorg..."
    /usr/bin/Xorg "$DISPLAY_NUM" \
        -config "$XORG_CONF" \
        -nolisten tcp \
        -noreset \
        vt7 \
        >> "$LOG_DIR/xorg.log" 2>&1 &
    echo $! > "$PID_DIR/xorg.pid"

    if ! wait_for_display "$DISPLAY_NUM" 30; then
        error "Xorg failed to start. Check: cat $LOG_DIR/xorg.log"
        kill_pid "$PID_DIR/xorg.pid" "Xorg"
        return 1
    fi
    success "Xorg started (PID $(cat "$PID_DIR/xorg.pid"))"

    # ── Xauth ─────────────────────────────────────────────────────────────────
    /usr/local/bin/vscreen-xauth-setup "$DISPLAY_NUM" 2>/dev/null || true

    # ── XDG runtime dir ───────────────────────────────────────────────────────
    local xdg_dir
    xdg_dir=$(setup_xdg_runtime)

    # ── XFCE4 ─────────────────────────────────────────────────────────────────
    info "Starting XFCE4 desktop..."
    su - "$VSCREEN_USER" -s /bin/bash -c "
        export DISPLAY=$DISPLAY_NUM
        export HOME=$VSCREEN_HOME
        export XDG_RUNTIME_DIR=$xdg_dir
        export XAUTHORITY=$VSCREEN_HOME/.Xauthority
        /usr/bin/dbus-launch --exit-with-session /usr/bin/xfce4-session \
            >> $LOG_DIR/desktop.log 2>&1 &
        echo \$! > $PID_DIR/desktop.pid
    "
    sleep 3
    success "XFCE4 started"

    # ── x11vnc ────────────────────────────────────────────────────────────────
    info "Starting VNC server..."
    /usr/bin/x11vnc \
        -display  "$DISPLAY_NUM" \
        -rfbport  "$VNC_PORT" \
        -rfbauth  "$PASSWD_FILE" \
        -shared -forever -repeat \
        -noxrecord -nowireframe -nodpms -threads \
        -logfile "$LOG_DIR/vnc.log" \
        >> "$LOG_DIR/vnc.log" 2>&1 &
    echo $! > "$PID_DIR/vnc.pid"

    sleep 1
    if pid_is_running "$PID_DIR/vnc.pid"; then
        success "VNC started (PID $(cat "$PID_DIR/vnc.pid"))"
    else
        error "VNC failed to start. Check: cat $LOG_DIR/vnc.log"
        return 1
    fi
}

direct_stop() {
    kill_pid "$PID_DIR/vnc.pid"     "x11vnc"
    kill_pid "$PID_DIR/desktop.pid" "XFCE4"
    kill_pid "$PID_DIR/xorg.pid"    "Xorg"
    # Clean up any orphans
    pkill -f "x11vnc.*${DISPLAY_NUM}" 2>/dev/null || true
    pkill -f "xfce4-session" 2>/dev/null || true
}

direct_is_running() {
    local svc="$1"
    case "$svc" in
        display) pid_is_running "$PID_DIR/xorg.pid"    ;;
        desktop) pid_is_running "$PID_DIR/desktop.pid"  ;;
        vnc)     pid_is_running "$PID_DIR/vnc.pid"      ;;
    esac
}

# ── VNC password ──────────────────────────────────────────────────────────────
set_vnc_password() {
    echo -e "${BOLD}Set VNC password${RESET}"
    echo "  This is what you'll enter in your VNC client to connect."
    echo "  (VNC passwords are max 8 characters)"
    echo ""

    local pass pass2
    while true; do
        read -rsp "  Password: " pass; echo ""
        if [[ -z "$pass" ]]; then
            warn "Password cannot be empty."
            continue
        fi
        if [[ ${#pass} -gt 8 ]]; then
            warn "VNC passwords are capped at 8 characters. Only the first 8 will be used."
        fi
        read -rsp "  Confirm:  " pass2; echo ""
        if [[ "$pass" == "$pass2" ]]; then break; fi
        warn "Passwords don't match. Try again."
    done

    x11vnc -storepasswd "$pass" "$PASSWD_FILE" 2>/dev/null
    chmod 600 "$PASSWD_FILE"
    success "VNC password set."
}

# ─────────────────────────────────────────────────────────────────────────────
# INSTALL
# ─────────────────────────────────────────────────────────────────────────────
cmd_install() {
    require_root install

    header "vscreen $VSCREEN_VERSION — installer"

    local init_mode
    init_mode=$(detect_init)
    echo "Init system: ${init_mode}"
    echo ""

    if ! grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
        warn "Not Ubuntu — vscreen is tested on 22.04/24.04. Continuing anyway."
    fi

    # ── User ──────────────────────────────────────────────────────────────────
    if ! id "$VSCREEN_USER" &>/dev/null; then
        info "Creating vscreen user..."
        useradd --system --create-home --shell /usr/sbin/nologin "$VSCREEN_USER"
        success "Created user: $VSCREEN_USER"
    else
        info "User $VSCREEN_USER already exists"
    fi
    mkdir -p "$VSCREEN_HOME"
    chown "$VSCREEN_USER":"$VSCREEN_USER" "$VSCREEN_HOME"

    # ── Directories ───────────────────────────────────────────────────────────
    mkdir -p "$LOG_DIR" "$PID_DIR" "$VSCREEN_DIR"
    chmod 755 "$LOG_DIR"

    # ── Packages ──────────────────────────────────────────────────────────────
    info "Installing packages..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    if ! apt-get install -y -qq \
        curl wget x11vnc xauth \
        xfce4 xfce4-terminal xfce4-notifyd thunar \
        dbus-x11 python3 \
        xserver-xorg-core xserver-xorg-video-dummy \
        x11-xserver-utils x11-utils \
        pciutils mesa-utils 2>/dev/null; then
        die "Package installation failed."
    fi
    success "Packages installed"

    # ── GPU ────────────────────────────────────────────────────────────────────
    info "Detecting GPU..."
    local detected_gpu
    detected_gpu=$(detect_gpu)

    # ── Config ────────────────────────────────────────────────────────────────
    if [[ ! -f "$VSCREEN_CONF" ]]; then
        GPU_MODE="$detected_gpu"; load_config; GPU_MODE="$detected_gpu"
        save_config
        success "Config written to $VSCREEN_CONF"
    else
        load_config
        local old_gpu="$GPU_MODE"
        GPU_MODE="$detected_gpu"
        save_config
        if [[ "$old_gpu" != "$detected_gpu" ]]; then
            info "GPU mode changed: ${old_gpu} → ${detected_gpu}"
        else
            info "Config preserved (GPU_MODE: ${GPU_MODE})"
        fi
    fi

    # ── EDID ──────────────────────────────────────────────────────────────────
    info "Writing EDID..."
    write_edid || die "Failed to write EDID. Is python3 installed?"
    success "EDID written"

    # ── Xorg ──────────────────────────────────────────────────────────────────
    info "Writing Xorg config (mode: ${GPU_MODE})..."
    write_xorg_conf
    success "Xorg config written"

    # ── Helper scripts ────────────────────────────────────────────────────────
    write_helper_scripts

    # ── Init-specific ─────────────────────────────────────────────────────────
    if [[ "$init_mode" == "systemd" ]]; then
        info "Installing systemd services..."
        write_systemd_services
        systemctl daemon-reload
        success "systemd services installed"
    else
        info "No systemd — vscreen will manage processes directly"
        success "Direct mode configured"
    fi

    # ── VNC password ──────────────────────────────────────────────────────────
    if [[ ! -f "$PASSWD_FILE" ]]; then
        echo ""
        set_vnc_password
    else
        info "VNC password already set. Change with: sudo vscreen password"
    fi

    # ── Install binary ────────────────────────────────────────────────────────
    local self
    self=$(realpath "$0" 2>/dev/null || echo "$0")
    if [[ "$self" != "/usr/local/bin/vscreen" ]]; then
        cp "$self" /usr/local/bin/vscreen
        chmod +x /usr/local/bin/vscreen
        success "vscreen installed to /usr/local/bin/vscreen"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}Installation complete.${RESET}"
    echo ""
    echo "  Start:   sudo vscreen start"
    echo "  Status:  sudo vscreen status"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# START
# ─────────────────────────────────────────────────────────────────────────────
cmd_start() {
    require_root start
    load_config

    [[ -f "$VSCREEN_CONF" ]] || die "vscreen not installed. Run: sudo vscreen install"
    [[ -f "$PASSWD_FILE"  ]] || die "No VNC password set. Run: sudo vscreen password"

    header "vscreen — starting"
    write_xorg_conf

    local init_mode
    init_mode=$(detect_init)

    if [[ "$init_mode" == "systemd" ]]; then
        write_systemd_services
        systemctl daemon-reload

        info "Starting virtual display..."
        if ! systemctl start vscreen-display; then
            error "Failed to start Xorg. Check: sudo journalctl -u vscreen-display -n 30"
            exit 1
        fi

        info "Waiting for display..."
        if ! wait_for_display "$DISPLAY_NUM" 30; then
            error "Display did not become ready. Check: sudo journalctl -u vscreen-display -n 30"
            exit 1
        fi

        info "Starting XFCE4 desktop..."
        if ! systemctl start vscreen-desktop; then
            error "Failed to start desktop. Check: sudo journalctl -u vscreen-desktop -n 30"
            exit 1
        fi

        sleep 2

        info "Starting VNC server..."
        if ! systemctl start vscreen-vnc; then
            error "Failed to start VNC. Check: sudo journalctl -u vscreen-vnc -n 30"
            exit 1
        fi
    else
        if ! direct_start; then
            error "Failed to start. Check logs: $LOG_DIR/"
            exit 1
        fi
    fi

    local ip
    ip=$(get_public_ip)

    echo ""
    echo -e "${GREEN}${BOLD}vscreen is running.${RESET}"
    echo ""
    echo -e "  ${BOLD}Connect:${RESET}  ${CYAN}${ip}:${VNC_PORT}${RESET}"
    echo ""
    echo -e "  Resolution:  ${RESOLUTION} @ ${REFRESH}Hz"
    echo -e "  Display:     ${DISPLAY_NUM}"
    echo -e "  GPU:         ${GPU_MODE}"
    echo -e "  Mode:        ${init_mode}"
    echo ""
    echo "  Open any VNC client and connect to the address above."
    echo "  Use your VNC password when prompted."
    echo ""
    warn "Make sure port ${VNC_PORT} (TCP) is open inbound on your firewall."
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# STOP
# ─────────────────────────────────────────────────────────────────────────────
cmd_stop() {
    require_root stop
    header "vscreen — stopping"

    local init_mode
    init_mode=$(detect_init)

    if [[ "$init_mode" == "systemd" ]]; then
        for svc in vscreen-vnc vscreen-desktop vscreen-display; do
            if systemctl is-active --quiet "$svc" 2>/dev/null; then
                systemctl stop "$svc" 2>/dev/null || warn "Failed to stop $svc"
            fi
        done
    else
        direct_stop
    fi

    success "Stopped."
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# RESTART
# ─────────────────────────────────────────────────────────────────────────────
cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

# ─────────────────────────────────────────────────────────────────────────────
# STATUS
# ─────────────────────────────────────────────────────────────────────────────
cmd_status() {
    require_root status
    load_config

    header "vscreen — status"
    echo ""

    local init_mode
    init_mode=$(detect_init)
    local all_active=true

    if [[ "$init_mode" == "systemd" ]]; then
        for svc in vscreen-display vscreen-desktop vscreen-vnc; do
            local state
            state=$(systemctl is-active "$svc" 2>/dev/null || echo "inactive")
            if [[ "$state" == "active" ]]; then
                echo -e "  ${GREEN}●${RESET} $svc"
            else
                echo -e "  ${RED}○${RESET} $svc  (${state})"
                all_active=false
            fi
        done
    else
        for svc_name in display desktop vnc; do
            local pidfile="$PID_DIR/${svc_name}.pid"
            [[ "$svc_name" == "display" ]] && pidfile="$PID_DIR/xorg.pid"
            if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
                echo -e "  ${GREEN}●${RESET} vscreen-${svc_name}  (PID $(cat "$pidfile"))"
            else
                echo -e "  ${RED}○${RESET} vscreen-${svc_name}"
                all_active=false
            fi
        done
    fi

    echo ""
    local ip
    ip=$(get_public_ip)

    if [[ "$all_active" == true ]]; then
        echo -e "  ${BOLD}Connect:${RESET}  ${CYAN}${ip}:${VNC_PORT}${RESET}"
    else
        echo -e "  ${YELLOW}Not all services are running.${RESET} Start with: sudo vscreen start"
    fi

    echo ""
    echo -e "  Resolution:  ${RESOLUTION} @ ${REFRESH}Hz"
    echo -e "  Display:     ${DISPLAY_NUM}"
    echo -e "  VNC port:    ${VNC_PORT}"
    echo -e "  Mode:        ${init_mode}"

    if [[ "${GPU_MODE}" == "nvidia" ]]; then
        local gpu_name
        gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo "NVIDIA")
        echo -e "  GPU:         ${GREEN}${gpu_name}${RESET} (hardware acceleration)"
    else
        echo -e "  GPU:         software (dummy driver)"
    fi

    echo ""

    if [[ "$all_active" != true ]]; then
        echo -e "  ${BOLD}Recent logs:${RESET}"
        if [[ "$init_mode" == "systemd" ]]; then
            for svc in vscreen-display vscreen-desktop vscreen-vnc; do
                local state
                state=$(systemctl is-active "$svc" 2>/dev/null || echo "inactive")
                if [[ "$state" != "active" ]]; then
                    echo -e "  ${RED}── $svc ──${RESET}"
                    journalctl -u "$svc" -n 5 --no-pager 2>/dev/null | sed 's/^/    /' || true
                    echo ""
                fi
            done
        else
            for logfile in "$LOG_DIR"/*.log; do
                [[ -f "$logfile" ]] || continue
                echo -e "  ${RED}── $(basename "$logfile") ──${RESET}"
                tail -5 "$logfile" 2>/dev/null | sed 's/^/    /' || true
                echo ""
            done
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# GPU
# ─────────────────────────────────────────────────────────────────────────────
cmd_gpu() {
    load_config
    header "vscreen — GPU info"
    echo ""

    if ! command -v lspci &>/dev/null; then
        warn "pciutils not installed"; echo ""; return
    fi

    if ! lspci 2>/dev/null | grep -qi "nvidia"; then
        echo "  No NVIDIA GPU detected — using software dummy driver."
        echo ""; return
    fi

    echo -e "  ${GREEN}✓${RESET}  NVIDIA GPU present"

    if ! command -v nvidia-smi &>/dev/null; then
        echo -e "  ${RED}✗${RESET}  Drivers not installed"
        echo "  Fix: sudo ubuntu-drivers autoinstall && sudo reboot"
        echo ""; return
    fi

    if ! nvidia-smi &>/dev/null; then
        echo -e "  ${RED}✗${RESET}  nvidia-smi failed"
        echo "  Try: sudo modprobe nvidia"; echo ""; return
    fi

    echo -e "  ${GREEN}✓${RESET}  nvidia-smi working"; echo ""

    nvidia-smi --query-gpu=name,driver_version,memory.total,utilization.gpu,temperature.gpu \
        --format=csv,noheader 2>/dev/null \
    | while IFS=',' read -r name driver mem util temp; do
        echo -e "  Name:     ${name# }"
        echo -e "  Driver:   ${driver# }"
        echo -e "  VRAM:     ${mem# }"
        echo -e "  Usage:    ${util# }"
        echo -e "  Temp:     ${temp# }°C"
    done
    echo ""

    if [[ "${GPU_MODE}" == "nvidia" ]]; then
        echo -e "  ${GREEN}✓${RESET}  vscreen is using the GPU"
    else
        echo -e "  ${YELLOW}⚠${RESET}  vscreen is using dummy driver — run: sudo vscreen install"
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# PASSWORD
# ─────────────────────────────────────────────────────────────────────────────
cmd_password() {
    require_root password
    header "vscreen — change VNC password"
    echo ""
    set_vnc_password

    local init_mode
    init_mode=$(detect_init)

    if [[ "$init_mode" == "systemd" ]]; then
        if systemctl is-active --quiet vscreen-vnc 2>/dev/null; then
            info "Restarting VNC..."; systemctl restart vscreen-vnc
            success "New password active."
        fi
    else
        if pid_is_running "$PID_DIR/vnc.pid"; then
            info "Restarting VNC..."
            kill_pid "$PID_DIR/vnc.pid" "x11vnc"
            sleep 1
            load_config
            /usr/bin/x11vnc -display "$DISPLAY_NUM" -rfbport "$VNC_PORT" \
                -rfbauth "$PASSWD_FILE" -shared -forever -repeat \
                -noxrecord -nowireframe -nodpms -threads \
                -logfile "$LOG_DIR/vnc.log" >> "$LOG_DIR/vnc.log" 2>&1 &
            echo $! > "$PID_DIR/vnc.pid"
            success "New password active."
        fi
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# RESOLUTION
# ─────────────────────────────────────────────────────────────────────────────
cmd_resolution() {
    require_root resolution
    local res="${1:-}"
    [[ -n "$res" ]] || die "Usage: vscreen resolution <WIDTHxHEIGHT>"
    [[ "$res" =~ ^[0-9]+x[0-9]+$ ]] || die "Invalid format. Use WIDTHxHEIGHT"

    load_config; RESOLUTION="$res"; save_config; write_xorg_conf

    local is_running=false init_mode
    init_mode=$(detect_init)
    if [[ "$init_mode" == "systemd" ]]; then
        systemctl is-active --quiet vscreen-display 2>/dev/null && is_running=true
    else
        direct_is_running display && is_running=true
    fi

    if [[ "$is_running" == true ]]; then
        info "Applying resolution..."
        local output; output=$(detect_output_name)
        if [[ -n "$output" ]] && DISPLAY="$DISPLAY_NUM" xrandr --output "$output" --mode "$res" 2>/dev/null; then
            success "Resolution set to $res (applied live)"
        else
            warn "Could not apply live — run: sudo vscreen restart"
            success "Resolution set to $res (on next restart)"
        fi
    else
        success "Resolution set to $res"
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# PORT
# ─────────────────────────────────────────────────────────────────────────────
cmd_port() {
    require_root port
    local port="${1:-}"
    [[ -n "$port" ]] || die "Usage: vscreen port <number>"
    [[ "$port" =~ ^[0-9]+$ ]] || die "Port must be a number."
    [[ "$port" -ge 1024 && "$port" -le 65535 ]] || warn "Port $port outside typical range."

    load_config; VNC_PORT="$port"; save_config

    local init_mode; init_mode=$(detect_init)
    if [[ "$init_mode" == "systemd" ]]; then
        write_systemd_services; systemctl daemon-reload
        if systemctl is-active --quiet vscreen-vnc 2>/dev/null; then
            info "Restarting VNC on port $port..."
            systemctl restart vscreen-vnc
        fi
    else
        if pid_is_running "$PID_DIR/vnc.pid"; then
            info "Restarting VNC on port $port..."
            kill_pid "$PID_DIR/vnc.pid" "x11vnc"
            sleep 1
            /usr/bin/x11vnc -display "$DISPLAY_NUM" -rfbport "$VNC_PORT" \
                -rfbauth "$PASSWD_FILE" -shared -forever -repeat \
                -noxrecord -nowireframe -nodpms -threads \
                -logfile "$LOG_DIR/vnc.log" >> "$LOG_DIR/vnc.log" 2>&1 &
            echo $! > "$PID_DIR/vnc.pid"
        fi
    fi

    success "VNC port set to $port"
    warn "Make sure port ${port} is open inbound."
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────────────────────────────────────
cmd_logs() {
    local svc="${1:-}" lines="${2:-30}" init_mode
    init_mode=$(detect_init)

    if [[ -z "$svc" ]]; then
        header "vscreen — recent logs"; echo ""
        if [[ "$init_mode" == "systemd" ]]; then
            for s in vscreen-display vscreen-desktop vscreen-vnc; do
                echo -e "  ${BOLD}── $s ──${RESET}"
                journalctl -u "$s" -n "$lines" --no-pager 2>/dev/null | sed 's/^/  /' || echo "  (no logs)"
                echo ""
            done
        else
            for logfile in "$LOG_DIR"/*.log; do
                [[ -f "$logfile" ]] || continue
                echo -e "  ${BOLD}── $(basename "$logfile") ──${RESET}"
                tail -"$lines" "$logfile" 2>/dev/null | sed 's/^/  /' || echo "  (no logs)"
                echo ""
            done
        fi
    else
        if [[ "$init_mode" == "systemd" ]]; then
            case "$svc" in
                display|xorg) svc="vscreen-display" ;;
                desktop|xfce) svc="vscreen-desktop" ;;
                vnc|x11vnc)   svc="vscreen-vnc" ;;
                vscreen-*)    ;;
                *) die "Unknown: $svc (use display, desktop, vnc)" ;;
            esac
            journalctl -u "$svc" -n "$lines" --no-pager 2>/dev/null
        else
            case "$svc" in
                display|xorg) svc="xorg" ;;
                desktop|xfce) svc="desktop" ;;
                vnc|x11vnc)   svc="vnc" ;;
                *) die "Unknown: $svc (use display, desktop, vnc)" ;;
            esac
            [[ -f "$LOG_DIR/${svc}.log" ]] && tail -"$lines" "$LOG_DIR/${svc}.log" || echo "(no log)"
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# UNINSTALL
# ─────────────────────────────────────────────────────────────────────────────
cmd_uninstall() {
    require_root uninstall
    header "vscreen — uninstall"
    warn "This will remove all vscreen components."
    read -rp "  Are you sure? [y/N] " confirm
    [[ "$confirm" =~ ^[yY]$ ]] || { echo "  Aborted."; exit 0; }

    local init_mode; init_mode=$(detect_init)
    if [[ "$init_mode" == "systemd" ]]; then
        for svc in vscreen-vnc vscreen-desktop vscreen-display; do
            systemctl stop "$svc" 2>/dev/null || true
            systemctl disable "$svc" 2>/dev/null || true
            rm -f "/etc/systemd/system/${svc}.service"
        done
        systemctl daemon-reload
    else
        direct_stop
    fi

    rm -f "$XORG_CONF" /usr/local/bin/vscreen-wait-display /usr/local/bin/vscreen-xauth-setup
    rm -rf "$VSCREEN_DIR" "$LOG_DIR" "$PID_DIR"

    if id "$VSCREEN_USER" &>/dev/null; then
        userdel "$VSCREEN_USER" 2>/dev/null || true
        info "User $VSCREEN_USER removed (home dir preserved)"
    fi

    success "vscreen uninstalled."
    rm -f /usr/local/bin/vscreen
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# HELP
# ─────────────────────────────────────────────────────────────────────────────
cmd_help() {
    cat <<EOF

${BOLD}vscreen${RESET} ${VSCREEN_VERSION} — virtual display over VNC

${BOLD}USAGE${RESET}
  sudo vscreen <command> [args]

${BOLD}COMMANDS${RESET}
  install               Install vscreen and all dependencies
  start                 Start virtual display + VNC server
  stop                  Stop everything
  restart               Stop then start
  status                Show running services and connection info
  password              Set or change the VNC password
  gpu                   Show GPU info and acceleration status
  resolution <WxH>      Change display resolution  (e.g. 2560x1440)
  port <number>         Change the VNC port        (default: 5900)
  logs [service] [n]    Show recent logs (service: display, desktop, vnc)
  uninstall             Remove vscreen completely
  help                  Show this help

${BOLD}NOTES${RESET}
  • Works with or without systemd (auto-detected).
  • Port 5900 must be open inbound (or tunnel over SSH).
  • VNC passwords are capped at 8 characters.

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# DISPATCH
# ─────────────────────────────────────────────────────────────────────────────
main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        install)    cmd_install    "$@" ;;
        start)      cmd_start      "$@" ;;
        stop)       cmd_stop       "$@" ;;
        restart)    cmd_restart    "$@" ;;
        status)     cmd_status     "$@" ;;
        password)   cmd_password   "$@" ;;
        gpu)        cmd_gpu        "$@" ;;
        resolution) cmd_resolution "$@" ;;
        port)       cmd_port       "$@" ;;
        logs)       cmd_logs       "$@" ;;
        uninstall)  cmd_uninstall  "$@" ;;
        help|--help|-h)       cmd_help ;;
        version|--version|-v) echo "vscreen $VSCREEN_VERSION" ;;
        *) error "Unknown command: $cmd"; cmd_help; exit 1 ;;
    esac
}

main "$@"
